# Node.js 22+; PostgreSQL 16+. Replace local credentials before use.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/tourismplatform
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_DAYS=7
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
DB_POOL_MAX=10
# Set only to the actual number of trusted reverse-proxy hops.
TRUST_PROXY_HOPS=0

# OTP Security Config
OTP_SECRET=replace_with_64_char_random_hex_secret_key_from_openssl
OTP_EXPIRY_MINUTES=5
OTP_BASE_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
# تفعيل الطباعة الاحتياطية في بيئة التطوير لتوفير الرصيد المجاني أو تجاوز قيود الأرقام غير الموثقة
OTP_DEV_FALLBACK=true

# Resend Config (Email - Free Tier uses onboarding@resend.dev)
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL="Travora <onboarding@resend.dev>"

# Twilio Config (SMS & WhatsApp Sandbox)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+14155238886